{
  "name": "dsh-workflow-panel",
  "version": "0.1.1",
  "type": "module",
  "description": "只读的项目工作流面板：概览、六道门、里程碑、组织模板、任务流、人员卡。Read-only project board for DSH.",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client/client.js",
    "./adapter": "./adapter.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "adapter.js",
    "client/client.js",
    "client/render.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workflow",
    "dashboard",
    "read-only"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tucaogege/dsh-workflow-panel.git"
  },
  "homepage": "https://github.com/tucaogege/dsh-workflow-panel",
  "bugs": {
    "url": "https://github.com/tucaogege/dsh-workflow-panel/issues"
  }
}
